# RentEase Environment Configuration Template

# Server Configuration (copy to server/.env)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rentease
JWT_SECRET=rentease_jwt_secret_key_production_2026_super_secure
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway (Test Credentials)
RAZORPAY_KEY_ID=rzp_test_rentease_key
RAZORPAY_KEY_SECRET=rzp_test_rentease_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="RentEase Support <support@rentease.in>"

# Client Configuration (copy to client/.env)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_rentease_key
