# RentEase Server — Environment Variables Template
# Copy this file to .env and replace placeholders with production keys.
# -------------------------------------------------------------------

# ── Environment & Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/rentease

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# ── Razorpay Payment Gateway ─────────────────────────────────────
# Replace with keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET

# ── Development Mock Payment Toggle ──────────────────────────────
# Set to 'false' in production. Set to 'true' only for local offline dev/testing.
ENABLE_MOCK_PAYMENTS=true

# ── Admin Account Provisioning ────────────────────────────────────
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_SECURE_ADMIN_PASSWORD
ADMIN_NAME=Platform Administrator

# ── SMTP Email Server (Optional) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_EMAIL
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
